# Frontend Environment Configuration

# The base URL for the backend API
# Development default: http://localhost:5000/api
# Production example: https://api.example.com/api
VITE_API_URL=https://api.example.com/api

# The base URL for the Socket.IO server
# Development default: http://localhost:5000
# Production example: https://api.example.com
VITE_SOCKET_URL=https://api.example.com

# Google Maps API Key for location tracking
VITE_MAP_API_KEY=your_google_maps_api_key_here
