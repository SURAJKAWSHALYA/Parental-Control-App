# Backend Environment Configuration

NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/parental_control

# JWT Configuration (Required)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Socket.IO Configuration
SOCKET_SECRET=your_socket_secret_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# S3 Storage Configuration
STORAGE_ENDPOINT=your_storage_endpoint_here
STORAGE_BUCKET=your_storage_bucket_name_here
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here

# AI Service Configuration
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here

# Logging Configuration
# Levels: error, warn, info, debug
LOG_LEVEL=info
